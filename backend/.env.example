MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/mechanics?retryWrites=true&w=majority
PORT=5000
# Supabase auth (optional): when set, server will verify Supabase access tokens
# SUPABASE_URL should be your Supabase project URL, e.g. https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY is the project's anon key (used to call /auth/v1/user)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# For production, use proper auth and secrets management
